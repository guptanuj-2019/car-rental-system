PORT=5000
NODE_ENV=production
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=<generate-a-long-random-secret>

# Email OTP delivery (required to send reset codes to email)
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# SMS OTP delivery (required to send reset codes to Indian mobile numbers)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Required only for receipt uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
